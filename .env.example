NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hermes
REDIS_URL=redis://localhost:6379

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-token
SLACK_SIGNING_SECRET=your_slack_signing_secret

# WhatsApp
WHATSAPP_ACCOUNT_SID=your_whatsapp_account_sid
WHATSAPP_AUTH_TOKEN=your_whatsapp_auth_token

# MCP Configuration
MCP_ENDPOINTS=http://localhost:3001,http://mcp-server.example.com:8080
MCP_API_KEY=your_mcp_api_key

# NPM Registry
NPM_REGISTRY_URL=https://registry.npmjs.org
NPM_TOKEN=npm_your_npm_token_here

# API Keys
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key

# Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production
ENCRYPTION_KEY=your_encryption_key_32_chars_long

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
